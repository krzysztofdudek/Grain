# grain — optional local environment (copy to .env; .env is gitignored and sourced by tests/stress/agent-trial.sh).
# Everything runs without this file: paths default to the repository the scripts live in.

# The plugin directory under test. Point it at a frozen copy while an A/B trial runs, so concurrent
# engine edits cannot contaminate the arms (tests/stress/agent-trial.sh).
#GRAIN_PLUGIN_DIR=/absolute/path/to/a/frozen/copy/of/plugins/grain

# Extra --settings file passed to the trial workers (tests/stress/agent-trial.sh).
#GRAIN_TRIAL_SETTINGS=

# A Yggdrasil checkout to regenerate the vendored relation extractors from (plugins/grain/scripts/build-relations.mjs).
#GRAIN_YGG_DIR=/absolute/path/to/Yggdrasil

# Engine switches (any grain invocation):
#GRAIN_V8=off          # disable the --liftoff-only re-exec (V8 optimises grammar WASM: faster long builds, ~500 MB more RSS)
#GRAIN_NO_REFRESH=1    # never auto-rebuild the index; stale answers carry a STALE banner
#GRAIN_DEBUG=1         # full stack traces on errors
#GRAIN_DBG=<substr>    # mining debug: print candidate cells whose surface id contains <substr>
