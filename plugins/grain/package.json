{
  "name": "grain-engine",
  "version": "0.2.0",
  "private": true,
  "description": "grain — ask a repository about its own conventions before writing code.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "grain": "./bin/grain.mjs"
  },
  "scripts": {
    "build:grammars": "node scripts/build-grammars.mjs",
    "test": "node --test tests/*.test.mjs tests/relations/e2e/*.test.mjs tests/relations/e2e-cli/*.test.mjs tests/relations/unit/*/*.test.mjs",
    "build:relations": "node scripts/build-relations.mjs"
  },
  "devDependencies": {
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "@tree-sitter-grammars/tree-sitter-lua": "^0.4.1",
    "@tree-sitter-grammars/tree-sitter-toml": "^0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "^0.7.1",
    "@tree-sitter-grammars/tree-sitter-zig": "^1.1.2",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-groovy": "^0.1.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-properties": "^0.3.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-solidity": "^1.2.13",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.13"
  }
}
