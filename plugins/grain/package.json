{
  "name": "grain-engine",
  "version": "6.0.0",
  "private": true,
  "description": "grain — mine an architecture graph out of a repository that has none, from its own code and history.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "grain": "./bin/grain.mjs"
  },
  "scripts": {
    "build:grammars": "node scripts/build-grammars.mjs",
    "test": "node --test tests/*.test.mjs tests/relations/e2e/*.test.mjs tests/relations/e2e-cli/*.test.mjs tests/relations/unit/*/*.test.mjs",
    "build:relations": "node scripts/build-relations.mjs"
  },
  "devDependencies": {
    "@tree-sitter-grammars/tree-sitter-zig": "1.1.2",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-cli": "0.27.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-groovy": "0.1.2",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-properties": "0.3.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-scala": "0.24.0",
    "tree-sitter-solidity": "1.2.13",
    "web-tree-sitter": "0.27.0"
  }
}
