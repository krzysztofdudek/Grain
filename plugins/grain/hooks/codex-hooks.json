{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/grain.mjs\" session-context --mode codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\bin\\grain.mjs\" session-context --mode codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/grain.mjs\" check-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}\\\\bin\\\\grain.mjs\" check-hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/grain.mjs\" read-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}\\\\bin\\\\grain.mjs\" read-hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/grain.mjs\" check-hook --pre",
            "timeout": 15,
            "commandWindows": "node \"${PLUGIN_ROOT}\\\\bin\\\\grain.mjs\" check-hook --pre"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/grain.mjs\" commit-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}\\\\bin\\\\grain.mjs\" commit-hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/grain.mjs\" edit-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}\\\\bin\\\\grain.mjs\" edit-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
